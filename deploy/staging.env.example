# Install outside the repository as /etc/villaweb/staging.env, readable only by its service user.
APP_ENV=staging
APP_URL=https://staging.example.com
DATABASE_URL=postgresql://villaweb_staging:REPLACE@127.0.0.1:5432/villaweb_staging
DEV_FALLBACK_MODE=false
SESSION_SECRET=REPLACE_WITH_SEPARATE_RANDOM_SECRET
ICAL_SIGNING_SECRET=REPLACE_WITH_SEPARATE_RANDOM_SECRET
MFA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
CALENDAR_SYNC_SECRET=
VILLA_RUNTIME_DIRECTORY=/srv/villaweb-staging/runtime
# Never copy production uploads, credentials, customer records or cron configuration here.
