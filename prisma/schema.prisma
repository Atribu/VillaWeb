generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  PLATFORM_OWNER
  PLATFORM_ADMIN
  COMPANY_USER
}

enum CompanyStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MembershipRole {
  COMPANY_ADMIN
  SALES
  OPERATIONS
  FINANCE
  CRM
  CONTENT
  VILLA_MANAGER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum WebsiteStatus {
  LIVE
  STAGING
  PAUSED
}

enum VillaStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AvailabilityBlockType {
  RESERVED
  MAINTENANCE
  UNAVAILABLE
  OWNER_STAY
}

enum PricingRuleType {
  BASE
  SEASONAL
  WEEKEND
  SPECIAL_EVENT
}

enum DiscountMethod {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum CouponStatus {
  ACTIVE
  PAUSED
  EXPIRED
}

enum BookingRequestStatus {
  NEW
  CONTACT_PENDING
  CONTACTED
  OFFER_SENT
  APPROVED
  CANCELLED
}

enum RequestSource {
  WEB
  PANEL
  PHONE
  AGENCY
}

enum OperationTaskType {
  RESERVATION_TRACK
  SUPPLIER_APPROVAL
  REMINDER
  CHECK_IN
  CHECK_OUT
  CLEANING
}

enum OperationTaskStatus {
  PENDING
  READY
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  CANCELLED
}

enum PaymentType {
  DEPOSIT
  BALANCE
  REFUND
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum CashDirection {
  INCOME
  EXPENSE
}

enum CashEntrySource {
  AUTO_PAYMENT
  MANUAL
  REFUND
  ADJUSTMENT
}

enum ReviewStatus {
  PUBLISHED
  PENDING
  HIDDEN
}

enum ReviewSource {
  GOOGLE
  DIRECT
  WHATSAPP
}

enum CalendarDirection {
  IMPORT
  EXPORT
}

enum CalendarSourceStatus {
  HEALTHY
  WARNING
  ERROR
}

enum SyncMode {
  IMPORT_ONLY
  TWO_WAY
}

enum SyncOutcome {
  SUCCESS
  WARNING
  ERROR
}

enum AgencyKind {
  DIRECT_WEB
  PARTNER
  INTERNAL
}

enum AgencyStatus {
  ACTIVE
  PAUSED
}

enum BranchStatus {
  ACTIVE
  PAUSED
}

enum MessageStatus {
  NEW
  READ
  RESOLVED
  ARCHIVED
}

enum MessagePriority {
  LOW
  MEDIUM
  HIGH
}

enum CommissionScopeType {
  AGENCY
  BRANCH
  USER
  WEB_DIRECT
}

enum LandingPageStatus {
  DRAFT
  LIVE
  REVISION
}

enum ResourceDefinitionStatus {
  ACTIVE
  DRAFT
  PASSIVE
}

enum CurrencyRateStatus {
  LIVE
  MANUAL
  STALE
}

enum PaymentMethodStatus {
  ACTIVE
  PASSIVE
}

enum CacheGroupStatus {
  HEALTHY
  WARMING
  STALE
}

enum DocumentAssetStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum ShortcutStatus {
  ACTIVE
  HIDDEN
}

enum ExternalServiceStatus {
  ACTIVE
  WARNING
  OFFLINE
}

enum SeoContentType {
  BLOG
  LANDING
  CATEGORY
  PAGE
}

enum SeoContentStatus {
  PLANNED
  IN_PROGRESS
  PUBLISHED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model PlatformSetting {
  id                 String   @id @default(cuid())
  platformName       String
  defaultCurrency    String   @default("TRY")
  defaultLocale      String   @default("tr-TR")
  defaultTimezone    String   @default("Europe/Istanbul")
  supportEmail       String?
  supportPhone       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Company {
  id                 String                @id @default(cuid())
  slug               String                @unique
  legalName          String
  publicName         String
  shortName          String?
  panelName          String?
  status             CompanyStatus         @default(ACTIVE)
  primaryEmail       String?
  primaryPhone       String?
  whatsappNumber     String?
  supportHours       String?
  primaryDomain      String?               @unique
  taxNumber          String?
  timezone           String                @default("Europe/Istanbul")
  locale             String                @default("tr-TR")
  currency           String                @default("TRY")
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  memberships        CompanyMembership[]
  settings           CompanySetting?
  websites           CompanyWebsite[]
  currencyRates      CurrencyRate[]
  paymentMethods     PaymentMethod[]
  cacheGroups        CacheGroup[]
  documents          DocumentAsset[]
  shortcuts          ShortcutLink[]
  externalServices   ExternalService[]
  documentLinks      DocumentLink[]
  parameterGroups    ParameterGroup[]
  regions            Region[]
  villas             Villa[]
  campaigns          Campaign[]
  coupons            Coupon[]
  bookingRequests    BookingRequest[]
  operationTasks     OperationTask[]
  invoices           Invoice[]
  payments           Payment[]
  cashEntries        CashLedgerEntry[]
  reviews            GuestReview[]
  agencies           Agency[]
  branches           Branch[]
  messages           InternalMessage[]
  commissionRules    CommissionRule[]
  landingPages       LandingPage[]
  seoContents        SeoContent[]
  blogPosts          BlogPost[]
  syncSources        CalendarSyncSource[]
  syncMappings       CalendarSyncMapping[]
  syncLogs           CalendarSyncLog[]
  auditLogs          AuditLog[]
}

model User {
  id                 String                @id @default(cuid())
  username           String                @unique
  email              String                @unique
  name               String
  phone              String?
  passwordHash       String
  platformRole       PlatformRole          @default(COMPANY_USER)
  isActive           Boolean               @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  memberships        CompanyMembership[]
  sessions           AuthSession[]
  resetTokens        PasswordResetToken[]
  villasCreated      Villa[]
  availabilityBlocksCreated VillaAvailabilityBlock[]
  campaignsCreated   Campaign[]
  couponsCreated     Coupon[]
  requestsAssigned   BookingRequest[]      @relation("AssignedRequests")
  statusChanges      BookingRequestStatusHistory[]
  tasksAssigned      OperationTask[]
  cashEntriesCreated CashLedgerEntry[]
  messagesSent       InternalMessage[]
  auditLogs          AuditLog[]
}

model AuthSession {
  id                 String   @id @default(cuid())
  userId             String
  token              String   @unique
  expiresAt          DateTime
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id                 String   @id @default(cuid())
  userId             String
  token              String   @unique
  expiresAt          DateTime
  usedAt             DateTime?
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model CompanyMembership {
  id                 String            @id @default(cuid())
  companyId          String
  userId             String
  branchId           String?
  role               MembershipRole
  status             MembershipStatus  @default(INVITED)
  isPrimary          Boolean           @default(true)
  responsibility     String?
  lastActiveAt       DateTime?
  invitedAt          DateTime          @default(now())
  acceptedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch             Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([companyId, userId])
  @@index([companyId, role, status])
}

model CompanySetting {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  siteName           String
  defaultTitle       String?
  defaultDescription String?
  primaryPhone       String?
  primaryEmail       String?
  address            String?
  whatsappNumber     String?
  accentLabel        String?
  heroTitle          String?
  heroDescription    String?
  instagramUrl       String?
  facebookUrl        String?
  seoIndexable       Boolean  @default(true)
  allowCoupons       Boolean  @default(true)
  allowManualQuotes  Boolean  @default(true)
  leadResponseMinutes Int     @default(20)
  defaultMinNightCount Int    @default(3)
  defaultCleaningLeadHours Int @default(6)
  requestReminderHours Int    @default(12)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model CompanyWebsite {
  id                 String        @id @default(cuid())
  companyId          String
  name               String
  slug               String
  domain             String?
  locale             String        @default("tr-TR")
  isPrimary          Boolean       @default(false)
  status             WebsiteStatus @default(STAGING)
  primaryChannel     String?
  brandHeadline      String?
  metaTitle          String?
  metaDescription    String?
  themeKey           String?
  logoUrl            String?
  faviconUrl         String?
  analyticsKey       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  company            Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  villas             Villa[]
  campaigns          Campaign[]
  coupons            Coupon[]
  bookingRequests    BookingRequest[]
  landingPages       LandingPage[]
  seoContents        SeoContent[]
  blogPosts          BlogPost[]

  @@unique([companyId, slug])
}

model Region {
  id                 String    @id @default(cuid())
  companyId          String?
  name               String
  city               String
  districtScope      String[]  @default([])
  status             ResourceDefinitionStatus @default(ACTIVE)
  countryCode        String    @default("TR")
  latitude           Decimal?  @db.Decimal(10, 7)
  longitude          Decimal?  @db.Decimal(10, 7)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  company            Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  airports           Airport[]
  villas             Villa[]

  @@unique([companyId, name, city])
}

model Airport {
  id                 String   @id @default(cuid())
  regionId           String?
  name               String
  code               String   @unique
  city               String
  driveMinutes       Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  region             Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)
}

model Amenity {
  id                 String        @id @default(cuid())
  key                String        @unique
  label              String
  icon               String?
  category           String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  villas             VillaAmenity[]
}

model Villa {
  id                 String                  @id @default(cuid())
  companyId          String
  websiteId          String?
  regionId           String?
  createdByUserId    String?
  title              String
  titleEn            String?
  slug               String
  badge              String?
  badgeEn            String?
  category           String?
  categoryEn         String?
  shortDescription   String?
  shortDescriptionEn String?
  description        String
  descriptionEn      String?
  city               String
  district           String?
  address            String?
  latitude           Decimal?                @db.Decimal(10, 7)
  longitude          Decimal?                @db.Decimal(10, 7)
  capacity           Int
  bedroomCount       Int
  bathroomCount      Int
  poolType           String?
  poolTypeEn         String?
  nightlyBasePrice   Decimal                 @db.Decimal(12, 2)
  cleaningFee        Decimal                 @default(0) @db.Decimal(12, 2)
  minNightCount      Int                     @default(1)
  currency           String                  @default("TRY")
  status             VillaStatus             @default(DRAFT)
  featured           Boolean                 @default(false)
  averageRating      Decimal?                @db.Decimal(3, 2)
  reviewCount        Int                     @default(0)
  isSuperhost        Boolean                 @default(false)
  coverImageUrl      String?
  coverAlt           String?
  coverAltEn         String?
  seoTitle           String?
  seoTitleEn         String?
  seoDescription     String?
  seoDescriptionEn   String?
  focusKeyword       String?
  focusKeywordEn     String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  company            Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  website            CompanyWebsite?         @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  region             Region?                 @relation(fields: [regionId], references: [id], onDelete: SetNull)
  createdByUser      User?                   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  images             VillaImage[]
  amenities          VillaAmenity[]
  availabilityBlocks VillaAvailabilityBlock[]
  pricingRules       VillaPricingRule[]
  campaignLinks      CampaignVilla[]
  couponLinks        CouponVilla[]
  bookingRequests    BookingRequest[]
  operationTasks     OperationTask[]
  reviews            GuestReview[]
  viewEvents         VillaViewEvent[]
  liveSessions       VillaLiveSession[]
  dailyMetrics       VillaDailyMetric[]
  syncSources        CalendarSyncSource[]
  syncMappings       CalendarSyncMapping[]
  syncLogs           CalendarSyncLog[]

  @@unique([companyId, slug])
  @@index([companyId, status, featured])
}

model VillaImage {
  id                 String   @id @default(cuid())
  villaId            String
  url                String
  storageKey         String?
  altText            String?
  sortOrder          Int      @default(0)
  isCover            Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  villa              Villa    @relation(fields: [villaId], references: [id], onDelete: Cascade)

  @@index([villaId, sortOrder])
}

model VillaAmenity {
  id                 String   @id @default(cuid())
  villaId            String
  amenityId          String
  villa              Villa    @relation(fields: [villaId], references: [id], onDelete: Cascade)
  amenity            Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([villaId, amenityId])
}

model VillaAvailabilityBlock {
  id                 String                @id @default(cuid())
  villaId            String
  createdByUserId    String?
  startsAt           DateTime
  endsAt             DateTime
  blockType          AvailabilityBlockType
  note               String?
  sourceRequestId    String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  villa              Villa                 @relation(fields: [villaId], references: [id], onDelete: Cascade)
  createdByUser      User?                 @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([villaId, startsAt, endsAt])
}

model VillaPricingRule {
  id                 String          @id @default(cuid())
  villaId            String
  title              String
  ruleType           PricingRuleType
  startsAt           DateTime
  endsAt             DateTime
  nightlyPrice       Decimal         @db.Decimal(12, 2)
  cleaningFee        Decimal?        @db.Decimal(12, 2)
  minNightCount      Int?
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  villa              Villa           @relation(fields: [villaId], references: [id], onDelete: Cascade)

  @@index([villaId, startsAt, endsAt, isActive])
}

model Campaign {
  id                 String          @id @default(cuid())
  companyId          String
  websiteId          String?
  createdByUserId    String?
  name               String
  slug               String
  status             CampaignStatus  @default(DRAFT)
  discountMethod     DiscountMethod
  discountValue      Decimal         @db.Decimal(12, 2)
  startsAt           DateTime
  endsAt             DateTime
  bannerLabel        String?
  note               String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  website            CompanyWebsite? @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  createdByUser      User?           @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  villas             CampaignVilla[]

  @@unique([companyId, slug])
  @@index([companyId, status, startsAt, endsAt])
}

model CampaignVilla {
  id                 String   @id @default(cuid())
  campaignId         String
  villaId            String
  campaign           Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  villa              Villa    @relation(fields: [villaId], references: [id], onDelete: Cascade)

  @@unique([campaignId, villaId])
}

model Coupon {
  id                 String          @id @default(cuid())
  companyId          String
  websiteId          String?
  createdByUserId    String?
  code               String
  title              String
  description        String?
  status             CouponStatus    @default(ACTIVE)
  discountMethod     DiscountMethod
  discountValue      Decimal         @db.Decimal(12, 2)
  startsAt           DateTime
  endsAt             DateTime
  usageLimit         Int?
  usedCount          Int             @default(0)
  minimumStayNights  Int?
  minimumOrderAmount Decimal?        @db.Decimal(12, 2)
  isPublic           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  website            CompanyWebsite? @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  createdByUser      User?           @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  villas             CouponVilla[]
  redemptions        CouponRedemption[]

  @@unique([companyId, code])
  @@index([companyId, status, startsAt, endsAt])
}

model CouponVilla {
  id                 String   @id @default(cuid())
  couponId           String
  villaId            String
  coupon             Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  villa              Villa    @relation(fields: [villaId], references: [id], onDelete: Cascade)

  @@unique([couponId, villaId])
}

model BookingRequest {
  id                    String                       @id @default(cuid())
  companyId             String
  websiteId             String?
  villaId               String
  assignedToUserId      String?
  status                BookingRequestStatus        @default(NEW)
  source                RequestSource               @default(WEB)
  channelLabel          String?
  fullName              String
  phone                 String
  email                 String?
  guestCount            Int
  checkIn               DateTime
  checkOut              DateTime
  preferredContactDate  DateTime?
  preferredContactRange String?
  message               String?
  couponCodeText        String?
  quotedBaseAmount      Decimal?                    @db.Decimal(12, 2)
  quotedDiscountAmount  Decimal?                    @db.Decimal(12, 2)
  quotedCleaningFee     Decimal?                    @db.Decimal(12, 2)
  quotedTotalAmount     Decimal?                    @db.Decimal(12, 2)
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  company               Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  website               CompanyWebsite?             @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  villa                 Villa                       @relation(fields: [villaId], references: [id], onDelete: Cascade)
  assignedToUser        User?                       @relation("AssignedRequests", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  statusHistory         BookingRequestStatusHistory[]
  couponRedemption      CouponRedemption?
  operationTasks        OperationTask[]
  invoice               Invoice?
  payments              Payment[]
  cashEntries           CashLedgerEntry[]
  review                GuestReview?

  @@index([companyId, status, createdAt])
  @@index([villaId, checkIn, checkOut])
}

model CouponRedemption {
  id                 String         @id @default(cuid())
  couponId           String
  bookingRequestId   String         @unique
  discountAmount     Decimal        @db.Decimal(12, 2)
  createdAt          DateTime       @default(now())
  coupon             Coupon         @relation(fields: [couponId], references: [id], onDelete: Cascade)
  bookingRequest     BookingRequest @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
}

model BookingRequestStatusHistory {
  id                 String               @id @default(cuid())
  bookingRequestId   String
  oldStatus          BookingRequestStatus?
  newStatus          BookingRequestStatus
  changedByUserId    String?
  note               String?
  createdAt          DateTime             @default(now())
  bookingRequest     BookingRequest       @relation(fields: [bookingRequestId], references: [id], onDelete: Cascade)
  changedByUser      User?                @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([bookingRequestId, createdAt])
}

model OperationTask {
  id                 String              @id @default(cuid())
  companyId          String
  bookingRequestId   String?
  villaId            String?
  assigneeUserId     String?
  taskType           OperationTaskType
  status             OperationTaskStatus @default(PENDING)
  priority           TaskPriority        @default(MEDIUM)
  title              String
  detail             String?
  scheduledAt        DateTime
  scheduledTimeLabel String?
  assigneeLabel      String?
  supplierName       String?
  sourceLabel        String?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bookingRequest     BookingRequest?     @relation(fields: [bookingRequestId], references: [id], onDelete: SetNull)
  villa              Villa?              @relation(fields: [villaId], references: [id], onDelete: SetNull)
  assigneeUser       User?               @relation(fields: [assigneeUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status, scheduledAt])
  @@index([villaId, taskType])
}

model Invoice {
  id                 String         @id @default(cuid())
  companyId          String
  bookingRequestId   String?        @unique
  invoiceNumber      String
  status             InvoiceStatus  @default(DRAFT)
  issueDate          DateTime
  dueDate            DateTime
  subtotal           Decimal        @default(0) @db.Decimal(12, 2)
  discountTotal      Decimal        @default(0) @db.Decimal(12, 2)
  taxTotal           Decimal        @default(0) @db.Decimal(12, 2)
  cleaningFee        Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal        @db.Decimal(12, 2)
  paidTotal          Decimal        @default(0) @db.Decimal(12, 2)
  currency           String         @default("TRY")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bookingRequest     BookingRequest? @relation(fields: [bookingRequestId], references: [id], onDelete: SetNull)
  payments           Payment[]
  cashEntries        CashLedgerEntry[]

  @@unique([companyId, invoiceNumber])
  @@index([companyId, status, dueDate])
}

model Payment {
  id                 String        @id @default(cuid())
  companyId          String
  invoiceId          String
  bookingRequestId   String?
  paymentType        PaymentType
  status             PaymentStatus @default(PENDING)
  title              String?
  method             String
  amount             Decimal       @db.Decimal(12, 2)
  currency           String        @default("TRY")
  dueDate            DateTime?
  paidAt             DateTime?
  externalReference  String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  company            Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice            Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  bookingRequest     BookingRequest? @relation(fields: [bookingRequestId], references: [id], onDelete: SetNull)
  cashEntries        CashLedgerEntry[]

  @@index([companyId, status, dueDate])
}

model CashLedgerEntry {
  id                 String          @id @default(cuid())
  companyId          String
  paymentId          String?
  invoiceId          String?
  bookingRequestId   String?
  createdByUserId    String?
  direction          CashDirection
  category           String
  title              String
  note               String?
  amount             Decimal         @db.Decimal(12, 2)
  currency           String          @default("TRY")
  entryDate          DateTime
  source             CashEntrySource
  createdAt          DateTime        @default(now())
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payment            Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  invoice            Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  bookingRequest     BookingRequest? @relation(fields: [bookingRequestId], references: [id], onDelete: SetNull)
  createdByUser      User?           @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([companyId, entryDate, direction])
}

model GuestReview {
  id                 String        @id @default(cuid())
  companyId          String
  villaId            String
  bookingRequestId   String?       @unique
  guestName          String
  rating             Int
